#!/usr/bin/env bash
# share-frame-picker — custom picker for xdg-desktop-portal-hyprland.
# Offers "share-frame area" (shares exactly the inside of the frame) or falls
# back to the normal picker. Prints xdph's format on stdout:
#   [SELECTION]<flags>/region:<output>@<x>,<y>,<w>,<h>   (monitor-local, logical px)
set -uo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/share-frame/config"
fallback() {
  for p in "${SHARE_FRAME_FALLBACK_PICKER:-}" hyprland-preview-share-picker hyprland-share-picker; do
    [[ -n $p ]] && command -v "$p" >/dev/null && exec "$p" "$@"
  done
  echo "share-frame-picker: no fallback picker found" >&2; exit 1
}
[[ -f $CONF ]] || fallback "$@"

REMEMBER_SECONDS=${SHARE_FRAME_REMEMBER_SECONDS:-90}
STAMP="${XDG_RUNTIME_DIR:-/tmp}/share-frame-last-pick"
SHARING="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/share-frame-sharing"

requesting_app() {
  local objects apps
  objects=$(busctl --user --timeout=1 tree org.freedesktop.portal.Desktop --list 2>/dev/null) || return 1
  apps=$(sed -n 's|^/org/freedesktop/portal/desktop/request/\([^/]*\)/.*|\1|p' <<< "$objects" | sort -u)
  [[ -n $apps && $apps != *$'\n'* ]] && echo "$apps"
}

picked_frame_recently_by() {
  local app=$1 picked_app picked_at
  [[ -n $app && -f $STAMP ]] && read -r picked_app picked_at < "$STAMP" &&
    [[ $picked_app == "$app" && $picked_at =~ ^[0-9]+$ ]] &&
    (( $(date +%s) - picked_at < REMEMBER_SECONDS ))
}

remember_choice_of() {
  local app=$1 choice=$2
  if [[ -n $app && $choice == frame ]]; then echo "$app $(date +%s)" > "$STAMP"; else rm -f "$STAMP"; fi
}

app=$(requesting_app)
if [[ -n ${SHARE_FRAME_PICK:-} ]]; then
  choice=$SHARE_FRAME_PICK
elif picked_frame_recently_by "$app"; then
  choice=frame
else
  choice=$(/usr/bin/python3 "$HERE/picker_dialog.py") || choice=cancel
  remember_choice_of "$app" "$choice"
fi
case "$choice" in
  frame)
    touch "$SHARING"
    "$HERE/share-frame" show >/dev/null 2>&1
    st=$("$HERE/share-frame" status 2>/dev/null)   # "locked shown DP-1 WxH+X+Y"
    sel=$(/usr/bin/python3 - "$st" "$CONF" <<'P'
import re, sys
st, conf = sys.argv[1], sys.argv[2]
m = re.search(r"(\S+) (\d+)x(\d+)\+(-?\d+)\+(-?\d+)$", st)
if m:
    mon, w, h, x, y = m.groups()
else:
    c = {}
    for l in open(conf):
        if "=" in l and not l.lstrip().startswith("#"):
            k, v = l.split("=", 1); c[k.strip()] = v.split(" #")[0].strip()
    mon, x, y, w, h = c.get("monitor", ""), c["x"], c["y"], c["width"], c["height"]
print(f"region:{mon}@{x},{y},{w},{h}")
P
)
    echo "[SELECTION]/$sel" ;;
  other) fallback "$@" ;;
  *) exit 1 ;;
esac
