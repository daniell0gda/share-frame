#!/usr/bin/env bash
# Hide the frame after a share of the frame area (marked by share-frame-picker) ends.
# While the picker's marker file exists, polls PipeWire for the screencast stream of
# xdg-desktop-portal-hyprland and hides the frame once the stream was gone for hide_delay
# seconds. Without the marker it only checks that the file exists. Chromium opens short
# preview streams before the real one, so the delay stops the frame from flickering.
set -euo pipefail
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/share-frame/config"
SHARING="$RUNTIME/share-frame-sharing"
POLL_SECONDS="${SHARE_FRAME_POLL_SECONDS:-1}"
STREAM_NAME=xdph-streaming

exec 9>"$RUNTIME/share-frame-watch.lock"
flock -n 9 || exit 0

hide_delay_ms() {
  local seconds="${SHARE_FRAME_HIDE_DELAY:-}"
  [[ -z $seconds && -f $CONF ]] && seconds=$(sed -n 's/^hide_delay *= *\([0-9]\{1,\}\).*/\1/p' "$CONF")
  echo $(( ${seconds:-1} * 1000 ))
}

now_ms() { echo $(( ${EPOCHREALTIME/[.,]/} / 1000 )); }

hide_frame() {
  rm "$SHARING" 2>/dev/null && "$HERE/share-frame" hide >/dev/null 9>&-
  return 0
}

stream_seen=0
gone_since_ms=-1

while sleep "$POLL_SECONDS"; do
  if [[ ! -e $SHARING ]]; then
    stream_seen=0
    gone_since_ms=-1
    continue
  fi
  graph=$(pw-dump 2>/dev/null) || continue
  if [[ $graph == *"$STREAM_NAME"* ]]; then
    stream_seen=1
    gone_since_ms=-1
  elif (( stream_seen )); then
    (( gone_since_ms >= 0 )) || gone_since_ms=$(now_ms)
    if (( $(now_ms) - gone_since_ms >= $(hide_delay_ms) )); then
      hide_frame
      stream_seen=0
      gone_since_ms=-1
    fi
  fi
done
